{
  "name": "celsus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.js",
    "backend": "cd services/market-api && go run .",
    "build:backend": "cd services/market-api && go build -o bin/market-api .",
    "mobile": "cd apps/mobile && npx expo start",
