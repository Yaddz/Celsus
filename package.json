    "test:mobile": "npm --prefix apps/mobile test",
    "test:market": "cd services/market-api && go test ./...",
    "test:verify": "node scripts/test-lock.js verify",
    "test:lock": "node scripts/test-lock.js lock",
    "build:native": "node scripts/build-native-bridge.js"
  }
}
